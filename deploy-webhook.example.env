# 部署 webhook 监听端口。:9099 表示服务器所有网卡都能访问。
DEPLOY_WEBHOOK_ADDR=:9099

# curl 时用的简单密码。
DEPLOY_PASSWORD=change-this-password

# 服务器上项目目录。
PROJECT_DIR=/opt/game-rocker

# 要发布的分支。
DEPLOY_BRANCH=feature_examples

# Docker Compose 项目名。
COMPOSE_PROJECT_NAME=zjj-zombie-game

# 部署脚本路径。相对路径会基于 webhook 进程工作目录解析。
DEPLOY_SCRIPT=/opt/game-rocker/scripts/deploy-from-ghcr.sh
