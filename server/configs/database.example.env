# 是否启用数据库。当前默认仍使用本地 JSON 文件，改成 true 后启动时会连接 MySQL。
DB_ENABLED=false

# ORM 选择 GORM，数据库驱动先使用 MySQL。
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zjj_game
DB_USER=root
DB_PASSWORD=

# MySQL 连接参数。
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# 连接池配置。
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONN_MAX_LIFETIME=1h

# 登录态 Token 配置。生产环境必须替换为高强度随机字符串。
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_TOKEN_TTL=168h
