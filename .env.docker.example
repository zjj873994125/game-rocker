# Web 对外端口。本机访问 http://127.0.0.1:8080
WEB_PORT=8080

# 连接现有 MySQL 数据库。Docker Compose 不会创建或初始化数据库。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zombie_game_db
DB_USER=root
DB_PASSWORD=change-db-password

# 登录 Token 密钥。生产环境必须换成高强度随机字符串。
AUTH_TOKEN_SECRET=change-this-secret-before-deploy
AUTH_TOKEN_TTL=168h
